{
  "name": "pos-billing",
  "version": "1.0.0",
  "description": "GEET app (Expo + Electron desktop wrapper).",
  "author": "GEET app",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "mobile": "expo start --lan --clear",
    "mobile:tunnel": "expo start --tunnel --clear",
    "mobile:usb": "powershell -ExecutionPolicy Bypass -File scripts/start-expo-mobile.ps1 -Mode usb",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8085",
    "desktop": "concurrently -k -n web,electron -c cyan,magenta \"npm run web\" \"wait-on -t 120000 -d 15000 http-get://127.0.0.1:8085 && npm exec -- electron electron/main.js\"",
    "desktop:build": "expo export --platform web --output-dir dist && npm exec -- electron electron/main.js --prod",
    "desktop:installer": "node scripts/clean-electron-release.js && expo export --platform web --output-dir dist && electron-builder --win nsis --config.directories.output=%LOCALAPPDATA%\\\\POSBilling\\\\release",
    "build:apk": "eas build --platform android --profile preview",
    "ppt:demo": "node scripts/generate-demo-ppt.js"
  },
  "build": {
    "appId": "com.riye.posbilling.desktop",
    "productName": "GEET app",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-intent-launcher": "~13.0.8",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "jspdf": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-uuid": "^2.0.3",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "concurrently": "^9.2.0",
    "eas-cli": "^20.1.0",
    "electron": "^35.1.5",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0",
    "pptxgenjs": "^4.0.1",
    "wait-on": "^8.0.3"
  },
  "private": true
}
