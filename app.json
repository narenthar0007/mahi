{
  "expo": {
    "name": "NAM bill",
    "slug": "pos-billing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.riye.posbilling",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "sms"
        ],
        "NSCameraUsageDescription": "Allow NAM bill to scan QR codes to join a master device on local Wi-Fi.",
        "NSPhotoLibraryUsageDescription": "Allow NAM bill to access photos so you can upload your UPI QR code.",
        "NSLocalNetworkUsageDescription": "NAM bill uses the local network to sync orders with other shop devices without internet.",
        "NSBonjourServices": [
          "_nambill-sync._tcp."
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F5F0"
      },
      "package": "com.riye.posbilling",
      "versionCode": 7,
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE",
        "CHANGE_NETWORK_STATE",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.NEARBY_WIFI_DEVICES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "NAM bill",
      "shortName": "NAM bill",
      "themeColor": "#102A44",
      "backgroundColor": "#F5F5F0"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NAM bill to scan QR codes to join a master device on local Wi‑Fi.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NAM bill to access photos so you can upload your UPI QR code."
        }
      ],
      "./plugins/withGradleNetworkTimeout",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false,
            "usesCleartextTraffic": true,
            "manifestQueries": {
              "package": ["com.whatsapp", "com.whatsapp.w4b"],
              "intent": [
                {
                  "action": "android.intent.action.VIEW",
                  "data": { "scheme": "https" }
                },
                {
                  "action": "android.intent.action.VIEW",
                  "data": { "scheme": "whatsapp" }
                }
              ]
            }
          },
          "ios": {
            "newArchEnabled": false
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cb6a6cca-ec83-4e92-be97-4da8a8919344"
      }
    }
  }
}
