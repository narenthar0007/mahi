{
  "expo": {
    "name": "NAM bill",
    "slug": "pos-billing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.riye.posbilling",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "sms"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F5F0"
      },
      "package": "com.riye.posbilling",
      "versionCode": 4,
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "NAM bill",
      "shortName": "NAM bill",
      "themeColor": "#102A44",
      "backgroundColor": "#F5F5F0"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "manifestQueries": {
              "package": ["com.whatsapp", "com.whatsapp.w4b"],
              "intent": [
                {
                  "action": "android.intent.action.VIEW",
                  "data": { "scheme": "https" }
                },
                {
                  "action": "android.intent.action.VIEW",
                  "data": { "scheme": "whatsapp" }
                }
              ]
            }
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cb6a6cca-ec83-4e92-be97-4da8a8919344"
      }
    }
  }
}
